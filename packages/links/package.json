{
  "name": "@kanu/links",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cross-property links that point at the copy of the world you are in. Core has no dependencies; the browser rewriter is a separate entry point.",
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react.tsx",
    "./src/*": "./src/*"
  },
  "files": [
    "src"
  ],
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0"
  }
}
